Acc_period <- data %>%
filter(Loss_Year > 2020) %>%
select(Acc_Months) %>%
distinct() %>%
arrange(Acc_Months) %>%
rowwise() %>%
mutate(Dev_period = list(seq(1, Periods, 1))) %>%
unnest(Dev_period)
# Filter data based on val_class
Val_Data <- data %>%
select(Acc_Months, SETTLEDAMOUNT, Dev_period) %>%
mutate(SETTLEDAMOUNT = as.numeric(gsub("[^0-9.]", "", SETTLEDAMOUNT))) %>%
group_by(Acc_Months, Dev_period) %>%
summarise(Gross_Amount = sum(SETTLEDAMOUNT, na.rm = TRUE)) %>%
mutate(Dev_period = as.numeric(as.character(Dev_period))) %>%
right_join(Acc_period, by = c("Acc_Months", "Dev_period"))
# Create triangles
Inc_Tri <- as.triangle(Val_Data,
origin = "Acc_Months",
dev = "Dev_period",
value = "Gross_Amount")
# Convert to cumulative
Cum_Tri <- incr2cum(Inc_Tri)
# Perform Bootstrap
Boot_Method <- BootChainLadder(Cum_Tri, R = 9999)
# Summary
summary_Boot_Method <- summary(Boot_Method)$Totals
view(summary_Boot_Method)
# Confidence levels
confidence_level <- quantile(Boot_Method, c(0.75))
confidence_level <- confidence_level$ByOrigin
View(confidence_level)
data <- rbind(data_2021, data_2022, data_2023, data_2024, data_2025)
#Personal Lines
#val_class <- c("Personal Lines")
#Corporate Lines
val_class <- c("Corporate")
#SME Lines
#val_class <- c("SME")
data <- data %>%
filter(PRODUCT %in% val_class)
# Calculate IQR and Tukey's Fences
Q1 <- quantile(data$SETTLEDAMOUNT,na.rm = TRUE, 0.10)
Q3 <- quantile(data$SETTLEDAMOUNT,na.rm = TRUE, 0.90)
IQR <- Q3 - Q1
lower_fence <- Q1 - 1.5 * IQR
upper_fence <- Q3 + 1.5 * IQR
# Remove Outliers
data <- data %>%
filter(SETTLEDAMOUNT >= lower_fence & SETTLEDAMOUNT <= upper_fence)
#Filter for me where PAYMENTDATE and TREATMENTDATE are not NA
data <- data %>%
filter(!is.na(PAYMENTDATE))
# Assuming 'Claims_Data_PPO' is your dataset
data <- data %>%
mutate(Delay_in_Days = as.numeric(difftime(PAYMENTDATE, TREATMENTDATE, units = "days")))
#Calculate the mean delay in days
mean(data$Delay_in_Days, na.rm=TRUE)
data <- data %>%
mutate(check = ifelse(PAYMENTDATE >= TREATMENTDATE,'True','False'))
# Checking number of True and False Checks
check_counts <- table(data$check)
# Print the result
print(check_counts)
# Creating Adjusted_Tran_date, Ser_Year, Acc_Months, and Dev_period columns in the 'Claims_Data_PPO'dataset
data <- data %>%
mutate(
Adjusted_PAYMENTDATE = if_else(check == 'False', TREATMENTDATE + days(89), PAYMENTDATE),
Acc_Months_ = as.yearmon(TREATMENTDATE),
Acc_Year = as.integer(format(Acc_Months_, "%Y")),
Acc_Month = as.integer(format(Acc_Months_, "%m")),
Acc_Months = (Acc_Year - min(Acc_Year, na.rm = TRUE)) * 12 + Acc_Month - min(Acc_Month, na.rm = TRUE) + 1,
Loss_Year = year(TREATMENTDATE),
Dev_period = floor(difftime(Adjusted_PAYMENTDATE, TREATMENTDATE, units = "days") / (365.25/12)) + 1
)
# Generate Acc_period
Periods <- data %>%
filter(Loss_Year>2020) %>%
distinct(Acc_Months) %>%
nrow()
Acc_period <- data %>%
filter(Loss_Year > 2020) %>%
select(Acc_Months) %>%
distinct() %>%
arrange(Acc_Months) %>%
rowwise() %>%
mutate(Dev_period = list(seq(1, Periods, 1))) %>%
unnest(Dev_period)
# Filter data based on val_class
Val_Data <- data %>%
select(Acc_Months, SETTLEDAMOUNT, Dev_period) %>%
mutate(SETTLEDAMOUNT = as.numeric(gsub("[^0-9.]", "", SETTLEDAMOUNT))) %>%
group_by(Acc_Months, Dev_period) %>%
summarise(Gross_Amount = sum(SETTLEDAMOUNT, na.rm = TRUE)) %>%
mutate(Dev_period = as.numeric(as.character(Dev_period))) %>%
right_join(Acc_period, by = c("Acc_Months", "Dev_period"))
# Create triangles
Inc_Tri <- as.triangle(Val_Data,
origin = "Acc_Months",
dev = "Dev_period",
value = "Gross_Amount")
# Convert to cumulative
Cum_Tri <- incr2cum(Inc_Tri)
# Perform Bootstrap
Boot_Method <- BootChainLadder(Cum_Tri, R = 9999)
# Summary
summary_Boot_Method <- summary(Boot_Method)$Totals
view(summary_Boot_Method)
# Confidence levels
confidence_level <- quantile(Boot_Method, c(0.75))
confidence_level <- confidence_level$ByOrigin
View(confidence_level)
